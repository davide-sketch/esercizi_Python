    "# Esercizio 2\n",
    "import math\n",
    "\n",
    "def ipotenusa(catetoA, catetoB):\n",
    "  return math.sqrt(catetoA**2 + catetoB**2)\n",
    "\n",
    "ipotenusa(5,6)\n"
